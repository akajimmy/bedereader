# Text files are stored with LF line endings in the repository (each checkout converts as its platform prefers);
# the files below are binary and never converted.
* text=auto

# Windows command scripts need CRLF even when checked out elsewhere
*.bat text eol=crlf
*.cmd text eol=crlf
# shell scripts need LF
*.sh text eol=lf
# Flutter writes its generated plugin files with LF: checked out as CRLF, every `flutter pub get` rewrote them and the
# build's clean-tree check stopped it
komga_reader/windows/flutter/generated_* text eol=lf
komga_reader/linux/flutter/generated_* text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.otf binary
*.ttf binary
*.jks binary
*.keystore binary
*.zip binary
*.apk binary
