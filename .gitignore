__pycache__/
*.pyc

# Build pipeline output (tools/build.ps1)
dist/
# copies of library pages/books for image tests (not ours to publish)
testpages/

# private working notes and backlog (kept out of the public repository)
NOTES.md

# local development leftovers - kept on this PC, not published (2026-09-29):
# the image-tuning page and its helpers (the Enhance work is done), one-off preview entry points,
