# Secrets - never commit
apikey.txt
*.keystore
*.jks
key.properties

# Build outputs (komga_reader/.gitignore covers the Flutter build folders)
*.apk
*.aab

# Local safety copies made before overwriting files (e.g. the original Flutter icons)
backups/

# Tooling scratch
__pycache__/
*.pyc

# Build pipeline output (tools/build.ps1)
dist/
# copies of library pages/books for image tests (not ours to publish)
testpages/
