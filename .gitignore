tools/image-lab/
tools/sharpen_compare.py
tools/extract_pages.py
tools/icon_preview.png
komga_reader/lib/dev_*.dart
.claude/

# raw screenshots for the README (the chosen ones go, sized, into docs/images/)
screenshots/

# private reports (analysis, research) - kept on this PC
reports/
